#!/usr/bin/env python3
"""AEGISMESH SOAR CLI - independent repository; only its own service may change.

Configuration/secrets and runtime data stay outside the public Git checkout.
"""
import argparse
import getpass
import ipaddress
import os
from pathlib import Path
import re
import secrets
import shutil
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
from urllib.parse import urlsplit

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))
from ops import ui, health as health_module
EXPECTED_ROOT = Path('/opt/aegismesh/soar')
ENV_FILE = Path('/etc/aegismesh-soar/soar.env')
STATE = Path('/var/lib/aegismesh-soar')
UNIT = 'aegismesh-soar-bridge.service'
UNIT_DEST = Path('/etc/systemd/system') / UNIT
UNIT_SRC = ROOT / 'ops/systemd' / UNIT
MARKER = 'X-Aegismesh-Soar-Managed=yes'
REMOTE_URL = 'https://github.com/Jennylady/aegismesh-soar.git'
WRAPPER = Path('/usr/local/bin/aegismesh-soar')
DEFAULTS = {
    'SOAR_BIND_HOST': '127.0.0.1',
    'SOAR_PORT': '19081',
    'SOAR_DB': '/var/lib/aegismesh-soar/decisions.sqlite3',
    'SOAR_DB_BACKEND': 'sqlite',
    'SHUFFLE_WEBHOOK_URL': '',
    'SHUFFLE_WEBHOOK_HEADER_NAME': '',
    'SHUFFLE_WEBHOOK_HEADER_VALUE': '',
    'ENABLE_TEST_ACTIONS': 'false',
    'ENABLE_PROD_ACTIONS': 'false',
    'PROTECTED_CIDRS': '',
    'WAZUH_TEST_AGENTS': '000',
    'WAZUH_API_URL': 'https://127.0.0.1:55000',
    'WAZUH_USER': '',
    'WAZUH_PASSWORD': '',
    'WAZUH_TLS_INSECURE': 'false',
    'WAZUH_CA_FILE': '',
    'WAZUH_PROD_AGENT_IDS': '',
    'ENABLE_AD_REMEDIATION': 'false',
    'AD_DC_AGENT_ID': '',
    'AD_DOMAIN_DNS': '',
}


def fail(msg):
    ui.error(msg)
    raise SystemExit(2)


def cmd(args, check=True, capture=False, cwd=None):
    p = subprocess.run(args, cwd=cwd, text=True, stdout=subprocess.PIPE if capture else None,
                       stderr=subprocess.PIPE if capture else None)
    if check and p.returncode:
        fail(f"Commande échouée ({p.returncode}): {args[0]} {args[1] if len(args)>1 else ''}")
    return p


def root_required():
    if os.geteuid() != 0:
        fail('Exécuter avec sudo/root (installation et maintenance des services).')


def safe_root():
    if ROOT != EXPECTED_ROOT:
        fail(f'Installer le dépôt à {EXPECTED_ROOT} (actuellement {ROOT})')


def load_env():
    result = {}
    if ENV_FILE.exists():
        for line in ENV_FILE.read_text().splitlines():
            if line and not line.lstrip().startswith('#') and '=' in line:
                a, b = line.split('=', 1)
                result[a] = b
    return result


def atomic_env(values):
    root_required()
    ENV_FILE.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(ENV_FILE.parent, 0o700)
    merged = load_env()
    merged.update(values)
    fd, name = tempfile.mkstemp(prefix='.soar-env-', dir=str(ENV_FILE.parent), text=True)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, 'w') as f:
            for key, val in merged.items():
                if not re.fullmatch('[A-Z0-9_]+', key) or any(c in str(val) for c in '\r\n'):
                    fail('Configuration non valide')
                f.write(key + '=' + str(val) + '\n')
        os.replace(name, ENV_FILE)
    finally:
        if os.path.exists(name): os.unlink(name)


def health():
    cfg=load_env()
    ok, reason=health_module.probe(cfg.get('SOAR_BIND_HOST','127.0.0.1'),cfg.get('SOAR_PORT','19081'))
    return ok


def wait_health():
    cfg=load_env()
    with ui.Spinner('Attente du pont SOAR après démarrage'):
        ready, why=health_module.wait_ready(cfg.get('SOAR_BIND_HOST','127.0.0.1'),cfg.get('SOAR_PORT','19081'),seconds=18)
    if not ready:
        ui.warn('Le service systemd a été lancé, mais /health ne répond pas : '+why)
        health_module.print_diagnosis(cfg)
        fail('Démarrage non confirmé. Consulter le diagnostic ci-dessus ; aucun autre service modifié.')
    ui.ok('Pont SOAR disponible : '+why)



def tests():
    """Fail closed on tests before install/update; no real security actions."""
    testfiles = [ROOT/'tests/test_policy.py', ROOT/'tests/test_bridge.py', ROOT/'tests/test_cli.py', ROOT/'tests/test_update.py', ROOT/'tests/test_v3.py', ROOT/'tests/test_v31.py', ROOT/'tests/test_chain_v32.py', ROOT/'tests/test_action_adapters_v32.py', ROOT/'tests/test_webhook_url_v322.py', ROOT/'tests/test_ops_v323.py', ROOT/'tests/test_permissions_v324.py', ROOT/'tests/test_network_repair_v325.py', ROOT/'tests/test_live_actions_v33.py', ROOT/'tests/test_wazuh_tls_v33.py', ROOT/'tests/test_fleet_v34.py', ROOT/'tests/test_evidence_v35.py', ROOT/'tests/test_windows_diagnostics_v352.py', ROOT/'tests/test_windows_edr_v36.py', ROOT/'tests/test_edr_orchestrator_v37.py', ROOT/'tests/test_edr_setup_v371.py',ROOT/'tests/test_edr_flows_v372.py', ROOT/'tests/test_edr_flow_schema_v373.py', ROOT/'tests/test_edr_flow_session_v374.py',ROOT/'tests/test_ad_response_v38.py', ROOT/'tests/test_sqlite_lifecycle_v381.py', ROOT/'tests/test_postgres_migration_v39.py', ROOT/'tests/test_ad_lab_v39.py',ROOT/'tests/test_ad_api_readiness_v391.py',ROOT/'tests/test_manager_api_readiness_v391.py', ROOT/'tests/test_ad_lab_bridge_local_v392.py', ROOT/'tests/test_response_lifecycle_v40.py', ROOT/'tests/test_edr_triage_v40.py', ROOT/'tests/test_edr_root_guard_v401.py', ROOT/'tests/test_chain_readiness_v41.py', ROOT/'tests/test_audit_v42.py', ROOT/'tests/test_tenzir_conflict_v422.py', ROOT/'tests/test_f2b_nft_v425.py', ROOT/'tests/test_systemd_nft_v426.py']
    for f in (ROOT/'soar/bridge.py', ROOT/'soar/soarctl.py', ROOT/'bin/aegismesh-soar', ROOT/'ops/fleet.py', ROOT/'ops/wazuh/install_manager_evidence.py', ROOT/'ops/edr_velociraptor.py',ROOT/'ops/edr_enable.py',ROOT/'ops/orchestrate.py',ROOT/'ops/edr_setup_v371.py', ROOT/'ops/ad_control_v38.py', ROOT/'ops/database_pg_v39.py', ROOT/'ops/response_lifecycle_v40.py', ROOT/'ops/progressive_guard_v40.py', ROOT/'ops/audit_v42.py', ROOT/'ops/tenzir_conflict_v422.py'):
        cmd([sys.executable, '-m', 'py_compile', str(f)])
    for f in testfiles:
        cmd([sys.executable, str(f)])
    print('Tests locaux OK — simulateur Shuffle uniquement; aucun workflow réel déclenché.')


def controlled_unit():
    if not UNIT_DEST.exists():
        return False
    try:
        contents = UNIT_DEST.read_text()
    except OSError:
        fail('Unité préexistante illisible : inspection manuelle nécessaire')
    if MARKER not in contents:
        fail('Unité du même nom préexistante mais non gérée par ce dépôt : refus de remplacement')
    return True


def install(restart=True):
    root_required()
    safe_root()
    with ui.Spinner('Tests d’intégration hors production'):
        tests()
    was_installed = controlled_unit()
    if not ENV_FILE.exists():
        atomic_env({'DECISION_TOKEN': secrets.token_urlsafe(48),
                    'SHUFFLE_ACTION_TOKEN': secrets.token_urlsafe(48), **DEFAULTS})
        print('Configuration privée créée ; secrets générés uniquement sur le serveur.')
    else:
        print('Configuration privée conservée, aucun secret remplacé.')
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(STATE, 0o700)
    if not UNIT_SRC.exists() or MARKER not in UNIT_SRC.read_text():
        fail('Unité source invalide ou non marquée')
    shutil.copyfile(UNIT_SRC, UNIT_DEST)
    os.chmod(UNIT_DEST, 0o644)
    if WRAPPER.is_symlink() and WRAPPER.resolve() == ROOT/'bin/aegismesh-soar':
        pass
    elif WRAPPER.exists() or WRAPPER.is_symlink():
        fail('Conflit avec /usr/local/bin/aegismesh-soar')
    else:
        WRAPPER.symlink_to(ROOT/'bin/aegismesh-soar')
    cmd(['systemctl','daemon-reload'])
    if restart:
        if was_installed:
            cmd(['systemctl','restart',UNIT])
        else:
            cmd(['systemctl','enable','--now',UNIT])
        if cmd(['systemctl','is-active','--quiet',UNIT], check=False).returncode:
            fail('Service SOAR Bridge inactif après installation')
        wait_health()
    ui.ok('Installation validée dans /opt/aegismesh/soar ; autres services inchangés.')


def check_repo():
    safe_root()
    r = cmd(['git','rev-parse','--show-toplevel'], check=False, capture=True, cwd=ROOT)
    if r.returncode or Path(r.stdout.strip()) != ROOT:
        fail('Pas de dépôt Git valide dans /opt/aegismesh/soar')
    b = cmd(['git','branch','--show-current'],capture=True,cwd=ROOT).stdout.strip()
    if b != 'main': fail('Seule la branche main est autorisée pour update; branche actuelle='+b)
    remote = cmd(['git','remote','get-url','origin'],capture=True,cwd=ROOT).stdout.strip()
    good = {REMOTE_URL,'https://github.com/Jennylady/aegismesh-soar',
            'git@github.com:Jennylady/aegismesh-soar.git',
            'ssh://git@github.com/Jennylady/aegismesh-soar.git'}
    if remote not in good: fail('Remote origin inattendu : update refusé')
    dirty = cmd(['git','status','--porcelain'],capture=True,cwd=ROOT).stdout.strip()
    if dirty: fail('Working tree modifié ; commit/stash les changements avant update')


def update(check_only=False):
    """Kali -> GitHub -> GCP only. A failed candidate never becomes the final commit.

    `systemctl restart` now waits for /health via ExecStartPost in the new unit.
    This solves the V2 race even on the very first update to this version.
    """
    root_required()
    check_repo()
    old = cmd(['git','rev-parse','HEAD'],capture=True,cwd=ROOT).stdout.strip()
    old_managed = controlled_unit()
    old_ok = None
    if old_managed:
        old_ok = health()
        if not old_ok:
            ui.warn('Le bridge était déjà non sain AVANT la mise à jour; elle ne pourra pas résoudre un problème externe (port, secrets, droits).')
    print('Dépôt validé, commit courant:', old[:12])
    cmd(['git','fetch','--prune','origin','main'],cwd=ROOT)
    new = cmd(['git','rev-parse','origin/main'],capture=True,cwd=ROOT).stdout.strip()
    anc = cmd(['git','merge-base','--is-ancestor',old,new],check=False,cwd=ROOT)
    if anc.returncode: fail('La branche remote a divergé; aucun reset forcé')
    if old == new:
        print('Déjà à jour:', old[:12])
        if old_managed and not old_ok:
            health_module.print_diagnosis(load_env())
            fail('Code à jour, mais service indisponible. Corriger la panne de démarrage, pas Git.')
        return
    print('Mise à jour disponible:', old[:12], '→', new[:12])
    if check_only:
        print('Mode --check: aucun fichier modifié ni service redémarré.')
        return
    cmd(['git','merge','--ff-only','origin/main'],cwd=ROOT)
    try:
        with ui.Spinner('Tests pré-déploiement'):
            tests()
        if controlled_unit():
            # Only our own unit is replaced; config and secret files remain intact.
            shutil.copyfile(UNIT_SRC, UNIT_DEST)
            os.chmod(UNIT_DEST,0o644)
            cmd(['systemctl','daemon-reload'])
            # Important: ExecStartPost gates restart until /health is REALLY ready.
            cmd(['systemctl','restart',UNIT])
            cfg=load_env()
            ready, reason=health_module.wait_ready(cfg.get('SOAR_BIND_HOST','127.0.0.1'),
                                                   cfg.get('SOAR_PORT','19081'),seconds=5)
            if not ready or cmd(['systemctl','is-active','--quiet',UNIT],check=False).returncode:
                raise RuntimeError('Pont /health indisponible malgré systemd: '+reason)
            ui.ok('Pont SOAR confirmé par HTTP /health après systemd restart')
        else:
            ui.warn('Aucune unité SOAR gérée n’est installée; code mis à jour, utiliser aegismesh-soar install une fois.')
        ui.ok('Mise à jour réussie: '+new[:12])
    except BaseException as exc:
        print('Validation du candidat échouée :',type(exc).__name__,str(exc),file=sys.stderr)
        ui.warn('Diagnostic AVANT retour arrière (secrets non affichés) :')
        health_module.print_diagnosis(load_env())
        ui.warn('Dernières erreurs du bridge (si nécessaire): journalctl -u '+UNIT+' -n 70 --no-pager')
        # Preserve the rollback policy; do not modify Wazuh, Shuffle, Fail2ban or relay.
        cmd(['git','reset','--hard',old],cwd=ROOT)
        if controlled_unit():
            shutil.copyfile(UNIT_SRC,UNIT_DEST)
            os.chmod(UNIT_DEST,0o644)
            cmd(['systemctl','daemon-reload'])
            rollback = cmd(['systemctl','restart',UNIT],check=False)
            if rollback.returncode:
                ui.warn('ATTENTION: ancien service toujours en échec après rollback. Lire son journal systemd.')
        fail('Update annulé : le code précédent est restauré. Consulter le diagnostic ci-dessus.')


def validate_shuffle_webhook_url(value):
    """Accept both documented /hooks and /webhooks endpoint paths.

    Validation is intentionally strict: never silently rewrite hosts, ports,
    schemes, credentials or arbitrary URL paths. The caller can select the
    on-host backend port (15001) when copying a frontend-generated URI (18031).
    """
    if not isinstance(value, str) or not value or value != value.strip():
        raise ValueError('URL de webhook vide ou contenant des espaces en début/fin')
    if '\\' in value or any(c in value for c in '\r\n\t'):
        raise ValueError('URL mal formée : coller http:// sans antislash avant :')
    try:
        u = urlsplit(value)
        port = u.port   # Force validation of malformed port numbers
    except ValueError:
        raise ValueError('URL de webhook invalide (syntaxe ou port)') from None
    if u.scheme not in ('http', 'https') or not u.hostname:
        raise ValueError('URL de webhook non HTTP(S) ou sans hôte')
    if (u.username is not None or u.password is not None or u.query or u.fragment):
        raise ValueError('URL de webhook avec identifiants, paramètres ou fragment interdits')
    if not re.fullmatch(r'/api/v1/(?:hooks|webhooks)/webhook_[A-Za-z0-9_-]+', u.path):
        raise ValueError('Chemin webhook attendu : /api/v1/hooks/webhook_ID ou /api/v1/webhooks/webhook_ID')
    if u.scheme == 'http' and u.hostname not in ('127.0.0.1', 'localhost', '::1'):
        raise ValueError('Webhook HTTP permis uniquement en loopback; utiliser HTTPS ailleurs')
    return value


def rotate_action_token():
    """Replace the exposed callback credential without changing any other token."""
    root_required()
    if not ENV_FILE.exists():
        fail('Configuration privée absente; utiliser aegismesh-soar install')
    if not sys.stdin.isatty():
        fail('Rotation interactive requise pour éviter une exposition du secret via des scripts')
    print('La rotation invalidera immédiatement le jeton actuellement présent dans Shuffle.')
    if input('Pour confirmer, saisir ROTATE : ').strip() != 'ROTATE':
        ui.warn('Rotation annulée; aucun secret modifié.')
        return
    old=load_env().get('SHUFFLE_ACTION_TOKEN','')
    new=secrets.token_urlsafe(48)
    atomic_env({'SHUFFLE_ACTION_TOKEN':new})
    if controlled_unit():
        try:
            result=subprocess.run(['systemctl','restart',UNIT],check=False)
            if result.returncode:
                raise RuntimeError('systemctl restart a échoué')
            cfg=load_env()
            good, reason=health_module.wait_ready(cfg.get('SOAR_BIND_HOST','127.0.0.1'),cfg.get('SOAR_PORT','19081'),seconds=18)
            if not good:
                raise RuntimeError('bridge non sain après rotation: '+reason)
        except Exception:
            atomic_env({'SHUFFLE_ACTION_TOKEN':old})
            subprocess.run(['systemctl','restart',UNIT],check=False)
            fail('Rotation annulée et ancien secret restauré; vérifier les journaux du bridge')
    ui.ok('Jeton de rappel renouvelé. L’ancien jeton est désormais invalide.')
    print('COPIER UNE SEULE FOIS dans X-Aegismesh-Token de l’action HTTP Shuffle :')
    print(new)
    print('Ne pas copier ce jeton dans GitHub, une capture ou la conversation.')


def show_logs(args):
    """Show the bridge's own systemd logs, not the main AEGISMESH logs."""
    root_required()
    lines=max(1,min(int(args.lines),500))
    cmd(['journalctl','-u',UNIT,'--no-pager','--output=short-iso','-n',str(lines)], check=False)


def configure(args):
    root_required()
    if args.section in (None,'wizard'):
        return configure_wizard()
    if args.section == 'status':
        return configure_status()
    if args.section == 'rotate-action-token':
        return rotate_action_token()
    if not ENV_FILE.exists(): fail('Installer le service avant de modifier la configuration')
    updates = {}
    if args.section == 'webhook':
        value = args.value
        if not value:
            if sys.stdin.isatty(): value=input('URL webhook Shuffle (saisie non masquée) : ').strip()
            else: fail('Utiliser configure webhook URL ou configure sans argument pour le menu')
        try:
            updates['SHUFFLE_WEBHOOK_URL'] = validate_shuffle_webhook_url(value)
        except ValueError as exc:
            fail(str(exc))
    elif args.section == 'bind':
        value=args.value or (input('Adresse IPv4 de bind : ').strip() if sys.stdin.isatty() else '')
        try: address = ipaddress.ip_address(value)
        except ValueError: fail('IP invalide')
        if address.version != 4 or not (address.is_private or address.is_loopback):
            fail('Seule une IPv4 privée ou loopback appartenant à cet hôte est autorisée')
        out = cmd(['ip','-o','-4','addr','show'],capture=True).stdout
        locals_ = [part.removeprefix('inet').split('/')[0] for row in out.splitlines() for part in row.split() if '/' in part and part.count('.')==3]
        if str(address) not in locals_: fail('Adresse non attribuée à une interface de ce serveur')
        updates['SOAR_BIND_HOST'] = str(address)
    elif args.section == 'wazuh-proof-agents':
        value=args.value or (input('IDs Wazuh autorisés pour la preuve (001,002,006) : ').strip() if sys.stdin.isatty() else '')
        ids=[x.strip() for x in value.split(',') if x.strip()]
        if not ids or len(ids)>15 or any(not re.fullmatch(r'\d{3}', i) for i in ids):
            fail('IDs attendus : liste de 1 à 15 identifiants Wazuh sur 3 chiffres')
        updates['WAZUH_TEST_AGENTS']=','.join(sorted(set(ids)))
    elif args.section in ('windows-agent','windows-dc-agent'):
        value=args.value or (input('ID Windows (3 chiffres) : ').strip() if sys.stdin.isatty() else '')
        if not re.fullmatch(r'\d{3}',value) or value == '000':
            fail('ID Windows requis sur trois chiffres, manager 000 interdit')
        current=load_env()
        ordinary={x.strip() for x in current.get('WAZUH_WINDOWS_AGENT_IDS','').split(',') if x.strip()}
        dc={x.strip() for x in current.get('WAZUH_WINDOWS_DC_AGENT_IDS','').split(',') if x.strip()}
        if args.section == 'windows-dc-agent':
            if not sys.stdin.isatty() or input('Autoriser les blocages IPv4 publics cibles sur ce CONTROLEUR AD ? Ecrire AUTORISER-DC : ').strip() != 'AUTORISER-DC':
                fail('Autorisation speciale AD refusee')
            if value in ordinary: fail('Retirer cet ID de la liste Windows LAB avant autorisation DC')
            dc.add(value)
            updates={'WAZUH_WINDOWS_DC_AGENT_IDS':','.join(sorted(dc))}
        else:
            if value in dc: fail('Cet agent est declare DC et ne peut etre autorise comme LAB')
            ordinary.add(value)
            updates={'WAZUH_WINDOWS_AGENT_IDS':','.join(sorted(ordinary))}
    elif args.section == 'enable-tests':
        updates['ENABLE_TEST_ACTIONS'] = 'true'
    elif args.section == 'disable-tests':
        updates['ENABLE_TEST_ACTIONS'] = 'false'
    elif args.section == 'shuffle-auth':
        name = input('Nom du header requis par le webhook Shuffle : ').strip()
        value = getpass.getpass('Valeur du header (saisie masquée) : ')
        if not re.fullmatch(r'[A-Za-z0-9-]{1,60}',name) or not value or any(c in '\r\n' for c in value):
            fail('Header ou secret invalide')
        updates = {'SHUFFLE_WEBHOOK_HEADER_NAME': name,
                   'SHUFFLE_WEBHOOK_HEADER_VALUE': value}
    elif args.section == 'wazuh-url':
        value=args.value or (input('URL HTTPS locale de l’API Wazuh : ').strip() if sys.stdin.isatty() else '')
        try:
            u=urlsplit(value)
            addr=ipaddress.ip_address(u.hostname)
        except (ValueError,TypeError):
            fail('URL Wazuh invalide; utiliser https://127.0.0.1:55000 si API locale')
        if u.scheme != 'https' or not (addr.is_loopback or addr.is_private) or u.port != 55000 or u.username or u.password or u.path or u.query or u.fragment:
            fail('API Wazuh : HTTPS sur adresse loopback/privée, port 55000, sans chemin ni identifiants')
        updates={'WAZUH_API_URL':value}
    elif args.section == 'wazuh-ca':
        path=Path(args.value or (input('Chemin du certificat CA Wazuh (.pem) : ').strip() if sys.stdin.isatty() else ''))
        if not path.is_absolute() or not path.is_file(): fail('Certificat CA Wazuh non trouvé (chemin absolu requis)')
        import ssl
        try: ssl.create_default_context(cafile=str(path))
        except (OSError,ssl.SSLError) as exc: fail('Certificat CA non valide: '+type(exc).__name__)
        updates={'WAZUH_CA_FILE': str(path)}
    elif args.section == 'production':
        if not sys.stdin.isatty(): fail('Activation production uniquement en terminal interactif')
        print('Actions réelles: Fail2ban sur le serveur; Wazuh AR sur Linux et Windows explicitement autorises.')
        print('Les IP privees et IP de gestion restent interdites. Windows/DC exigent une autorisation distincte.')
        cidrs=input('CIDR publics à protéger (IP de ton accès gcloud/SSH, séparés par virgules) : ').strip()
        try:
            networks=[ipaddress.ip_network(x.strip(), strict=False) for x in cidrs.split(',') if x.strip()]
        except ValueError:
            fail('Liste CIDR invalide')
        if not networks:
            fail('PROTECTED_CIDRS obligatoire avant toute action réelle')
        agents=input('IDs des agents Linux autorisés (ex. 002; vide = aucun) : ').strip()
        ids=[x.strip() for x in agents.split(',') if x.strip()]
        if any(not re.fullmatch(r'\d{3}',x) or x == '000' for x in ids):
            fail('IDs Wazuh invalides ou manager local interdit')
        print('Réseaux protégés :',','.join(map(str,networks)))
        print('Agents autorisés :',','.join(ids) or 'aucun')
        if input('Activer les actions réelles ? Saisir ACTIVER : ').strip() != 'ACTIVER':
            fail('Activation annulée')
        updates={'PROTECTED_CIDRS':','.join(map(str,networks)),
                 'WAZUH_PROD_AGENT_IDS':','.join(ids),
                 'ENABLE_PROD_ACTIONS':'true'}
    elif args.section == 'disable-production':
        updates={'ENABLE_PROD_ACTIONS':'false'}
    elif args.section == 'wazuh':
        user = input('Utilisateur API Wazuh (droits minimaux) : ').strip()
        password = getpass.getpass('Mot de passe API Wazuh : ')
        if not user or not password or any(c in '\r\n' for c in user+password): fail('Identifiants invalides')
        updates = {'WAZUH_USER':user,'WAZUH_PASSWORD':password}
    else:
        fail('Paramètre non reconnu')
    atomic_env(updates)
    if controlled_unit():
        cmd(['systemctl','restart',UNIT])
        wait_health()
    ui.ok('Configuration modifiée; secrets non affichés; autres services inchangés.')


def configure_status():
    cfg=load_env()
    print('\n  CONFIGURATION DE LA CHAÎNE SOAR (secrets masqués)')
    fields=[
        ('Écoute locale',cfg.get('SOAR_BIND_HOST','127.0.0.1')+':'+cfg.get('SOAR_PORT','19081')),
        ('Webhook Shuffle','configuré' if cfg.get('SHUFFLE_WEBHOOK_URL') else 'à configurer'),
        ('Authentification webhook','configurée' if cfg.get('SHUFFLE_WEBHOOK_HEADER_NAME') and cfg.get('SHUFFLE_WEBHOOK_HEADER_VALUE') else 'non configurée'),
        ('Identifiants API Wazuh','configurés' if cfg.get('WAZUH_USER') and cfg.get('WAZUH_PASSWORD') else 'à configurer'),
        ('Tests actifs',cfg.get('ENABLE_TEST_ACTIONS','false')),
        ('Actions production',cfg.get('ENABLE_PROD_ACTIONS','false')),
        ('Agents Linux autorisés', cfg.get('WAZUH_PROD_AGENT_IDS') or 'aucun'),
        ('Windows LAB autorisés',cfg.get('WAZUH_WINDOWS_AGENT_IDS') or 'aucun'),
        ('Windows DC autorisés',cfg.get('WAZUH_WINDOWS_DC_AGENT_IDS') or 'aucun'),
        ('Réseaux protégés', 'configurés' if cfg.get('PROTECTED_CIDRS') else 'non définis'),
        ('Base de données','configurée' if cfg.get('SOAR_DB') else 'défaut'),
    ]
    for label,val in fields:
        print('  '+label.ljust(27)+' : '+val)
    health_module.print_diagnosis(cfg)


def configure_wizard():
    if not sys.stdin.isatty():
        print('Mode interactif requis. Commandes: configure status | webhook URL | shuffle-auth | wazuh | wazuh-ca /chemin/ca.pem | bind IP | enable-tests | disable-tests')
        return
    while True:
        choice=ui.menu('CONFIGURATION GUIDÉE — aucun secret affiché',[
            ('1','État actuel et santé du bridge'),
            ('2','Webhook Shuffle (après création du workflow)'),
            ('3','Header d’authentification Shuffle'),
            ('4','Accès API Wazuh'),
            ('5','Adresse privée pour le rappel depuis Shuffle Docker'),
            ('6','Activer les tests de sécurité contrôlés'),
            ('7','Désactiver les tests de sécurité'),
            ('8','Diagnostic installations existantes'),
            ('9','Certificat CA pour API Wazuh (TLS vérifié)'),
            ('13','Adresse HTTPS privée de l’API Wazuh (55000)'),
            ('10','Renouveler le jeton de rappel Shuffle (rotation sécurisée)'),
            ('11','Configurer et autoriser les remédiations de production'),
        ('12','Désactiver immédiatement les remédiations de production'),
        ('0','Terminer')])
        if choice in ('0',None,''): break
        names={'2':'webhook','3':'shuffle-auth','4':'wazuh','5':'bind','6':'enable-tests','7':'disable-tests','9':'wazuh-ca','13':'wazuh-url','11':'production','12':'disable-production'}
        if choice=='1': configure_status()
        elif choice=='10': rotate_action_token()
        elif choice=='8': run_doctor()
        elif choice in names:
            class C: pass
            a=C();a.section=names[choice];a.value=''
            try:
                if choice=='6' and input('Activer les tests avec actions réelles contrôlées ? (écrire OUI) : ')!='OUI':
                    ui.warn('Activation annulée');continue
                configure(a)
            except (ValueError,KeyboardInterrupt) as e: ui.warn('Configuration interrompue, aucun autre service modifié')
        else: ui.warn('Choix non reconnu')


def repo_access(action):
    root_required()
    check_repo()
    ssh_url='git@github.com:Jennylady/aegismesh-soar.git'
    current=cmd(['git','remote','get-url','origin'],cwd=ROOT,capture=True).stdout.strip()
    print('Origin actuel :', 'SSH GitHub' if current.startswith(('git@github.com:','ssh://')) else 'HTTPS GitHub')
    if action=='status':
        print('Public: HTTPS suffit pour fetch. Privé: une clé SSH de déploiement en lecture seule est recommandée.')
        return
    keydir=Path('/etc/aegismesh-soar/keys')
    key=keydir/'github_deploy_ed25519'
    keydir.mkdir(parents=True,exist_ok=True,mode=0o700)
    os.chmod(keydir,0o700)
    if not key.exists():
        cmd(['ssh-keygen','-q','-t','ed25519','-N','','-f',str(key),'-C','aegismesh-soar-deploy'])
    os.chmod(key,0o600)
    pub=key.with_suffix('.pub')
    if not pub.exists(): fail('Fichier de clé publique manquant; vérifier /etc/aegismesh-soar/keys')
    print('\nCLÉ PUBLIQUE À AJOUTER DANS GitHub > Settings > Deploy keys (lecture seule) :')
    print(pub.read_text().strip())
    print('\nAucune clé privée n’est affichée. Après ajout sur GitHub : aegismesh-soar repo use-ssh')
    if action=='prepare-private': return
    command=f'ssh -i {key} -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=8'
    env=os.environ.copy();env['GIT_SSH_COMMAND']=command;env['GIT_TERMINAL_PROMPT']='0'
    try:
        p=subprocess.run(['git','ls-remote',ssh_url,'refs/heads/main'],cwd=ROOT,
                         env=env,capture_output=True,text=True,timeout=25)
    except (subprocess.TimeoutExpired,OSError): fail('Connexion SSH GitHub indisponible; remote inchangé')
    if p.returncode or not p.stdout.strip():
        ui.warn('Accès SSH non validé; remote inchangé. Vérifier la Deploy key et la clé hôte GitHub dans known_hosts.')
        raise SystemExit(3)
    cmd(['git','remote','set-url','origin',ssh_url],cwd=ROOT)
    cmd(['git','config','--local','core.sshCommand',command],cwd=ROOT)
    ui.ok('Accès SSH validé, origin utilise désormais SSH (fonctionne aussi si dépôt privé).')


def main_menu():
    if not sys.stdin.isatty(): return False
    ui.banner()
    choice=ui.menu('CENTRE DE CONTRÔLE — choisir une opération',[
        ('1','État et diagnostic de l’installation'),
        ('2','Configuration guidée'),
        ('3','Installer / réparer le bridge'),
        ('4','Mise à jour depuis GitHub'),
        ('5','Préparer le passage de GitHub en privé'),
        ('6','Tests non destructifs'),
        ('7','Réseau Docker et Shuffle (lecture seule)'),
        ('0','Quitter')])
    actions={'1':['health','--verbose'],'2':['configure'],'3':['install'],
             '4':['update'],'5':['repo','prepare-private'],'6':['test'],'7':['network']}
    if choice in actions:
        sys.argv=[sys.argv[0]]+actions[choice]
        main()
    return True


def run_doctor():
    cmd([sys.executable,str(ROOT/'ops/doctor.py')])


def main():
    # Delegate raw submit flags before parsing our management arguments.
    # Otherwise argparse treats --tag/--confidence as unknown bridge flags.
    if len(sys.argv) > 1 and sys.argv[1] == 'submit':
        root_required()
        sys.path.insert(0,str(ROOT/'soar'))
        import soarctl
        sys.argv = ['soarctl.py', 'submit'] + sys.argv[2:]
        return soarctl.main()
    if len(sys.argv)==1 and main_menu(): return
    p=argparse.ArgumentParser(prog='aegismesh-soar', description='Gestion autonome de la chaîne SOAR AEGISMESH')
    p.add_argument('--no-color',action='store_true',help='Désactiver la couleur et l’animation')
    p.add_argument('--version',action='version',version=(ROOT/'VERSION').read_text().strip())
    sub=p.add_subparsers(dest='action',required=True)
    sub.add_parser('install',help='Crée uniquement le nouveau bridge SOAR et sa configuration privée')
    update_parser=sub.add_parser('update',help='git fetch + ff-only main + tests + restart du bridge; rollback si erreur')
    update_parser.add_argument('--check',action='store_true',help='Vérifier seulement, sans changer les fichiers')
    sub.add_parser('doctor',help='Diagnostic non destructif des installations préexistantes')
    sub.add_parser('test',help='Tests unitaires + intégration avec faux Shuffle local')
    hp=sub.add_parser('health',help='Vérification HTTP + diagnostic si indisponible')
    hp.add_argument('--verbose',action='store_true')
    c=sub.add_parser('configure',help='Paramétrer les connexions sans écraser Wazuh/Shuffle/Fail2ban')
    c.add_argument('section',nargs='?',choices=['status','wizard','webhook','bind','enable-tests','disable-tests','shuffle-auth','wazuh','wazuh-ca','wazuh-url','rotate-action-token','production','disable-production','wazuh-proof-agents','windows-agent','windows-dc-agent'])
    c.add_argument('value',nargs='?',default='')
    rep=sub.add_parser('repo',help='GitHub public/privé : état, clé de déploiement et accès SSH')
    rep.add_argument('operation',choices=['status','prepare-private','use-ssh'])
    net=sub.add_parser('network',help='Inventaire réseau Docker et test lecture seule Orborus → Bridge')
    net.add_argument('--check',action='store_true',help='Teste la santé HTTP dans le réseau d’Orborus, sans modifier le pare-feu')
    fix=net.add_mutually_exclusive_group()
    fix.add_argument('--repair-shuffle',action='store_true',help='Autoriser via UFW uniquement Docker Shuffle → bridge; exige --confirm')
    fix.add_argument('--undo-shuffle',action='store_true',help='Retirer uniquement la règle UFW AEGISMESH-SOAR; exige --confirm')
    net.add_argument('--confirm',action='store_true',help='Confirmation requise pour modification UFW')
    sub.add_parser('service-status',help='État de notre service uniquement')
    lg=sub.add_parser('logs',help='Journaux du bridge AEGISMESH-SOAR seulement')
    lg.add_argument('--lines',type=int,default=70,help='Nombre de lignes (1 à 500)')
    d=sub.add_parser('submit',help='Soumettre une décision au bridge')
    d.add_argument('arguments',nargs=argparse.REMAINDER)
    fleet=sub.add_parser('fleet',help='Inventaire Wazuh et preuves d’exécution des agents via Shuffle')
    fleet.add_argument('arguments',nargs=argparse.REMAINDER)
    database=sub.add_parser('database',help='PostgreSQL SOAR: inventaire et migration sûre de SQLite')
    database.add_argument('arguments',nargs=argparse.REMAINDER)
    ad=sub.add_parser('ad',help='AD/LDAP: état et activation contrôlée de la remédiation via Wazuh DC')
    ad.add_argument('arguments',nargs=argparse.REMAINDER)
    edr=sub.add_parser('edr',help='Velociraptor : API mTLS, clients, investigation et désisolement')
    edr.add_argument('arguments',nargs=argparse.REMAINDER)
    audit=sub.add_parser('audit',help='V4.2: preuves non destructives, réparation Tenzir contrôlée et test OBSERVE live')
    audit.add_argument('arguments',nargs=argparse.REMAINDER)
    orch=sub.add_parser('orchestrate',help='Vue unifiée et catalogue des actions sans saisie manuelle de score/IP')
    orch.add_argument('arguments',nargs=argparse.REMAINDER)
    response=sub.add_parser('response',help='Preuves réelles de blocage, rétraction, historique incident')
    response.add_argument('arguments',nargs=argparse.REMAINDER)
    chain=sub.add_parser('chain',help='Raccorder et valider la chaîne Shuffle → Wazuh/Fail2ban')
    chain.add_argument('arguments',nargs=argparse.REMAINDER)
    d=sub.add_parser('decision',help='État d’une décision')
    d.add_argument('decision_id')
    args=p.parse_args()
    if args.no_color: os.environ['NO_COLOR']='1'
    ui.banner()
    if args.action=='install': install()
    elif args.action=='update': update(args.check)
    elif args.action=='doctor': run_doctor()
    elif args.action=='test': tests()
    elif args.action=='health':
        good=health_module.print_diagnosis(load_env()) if args.verbose or not health() else True
        if good: ui.ok('Bridge SOAR répond correctement')
        sys.exit(0 if good else 1)
    elif args.action=='configure': configure(args)
    elif args.action=='repo': repo_access(args.operation)
    elif args.action=='network':
        if args.repair_shuffle or args.undo_shuffle:
            root_required()
            if not args.confirm: fail('Ajout/retrait UFW refusé sans --confirm')
            cmd([sys.executable,str(ROOT/'ops/network_repair.py'),
                'repair' if args.repair_shuffle else 'undo','--confirm'])
        else:
            cmd([sys.executable,str(ROOT/'ops/network_probe.py' if args.check else ROOT/'ops/network.py')])
    elif args.action=='fleet':
        cmd([sys.executable,str(ROOT/'ops/fleet.py')]+(args.arguments or ['status']))
    elif args.action=='chain':
        cmd([sys.executable,str(ROOT/'ops/chain.py')]+(args.arguments or ['status']))
    elif args.action=='database':
        cmd([sys.executable,str(ROOT/'ops/database_pg_v39.py')]+(args.arguments or ['status']))
    elif args.action=='ad':
        cmd([sys.executable,str(ROOT/'ops/ad_control_v38.py')]+(args.arguments or ['status']))
    elif args.action=='edr':
        subargs=args.arguments or ['status']
        if subargs[0] in ('doctor','setup','bootstrap'):
            cmd([sys.executable,str(ROOT/'ops/edr_setup_v371.py')]+subargs)
        else:
            cmd([sys.executable,str(ROOT/'ops/edr_velociraptor.py')]+subargs)
    elif args.action=='response':
        cmd([sys.executable,str(ROOT/'ops/response_lifecycle_v40.py')]+(args.arguments or ['audit']))
    elif args.action=='audit':
        cmd([sys.executable,str(ROOT/'ops/audit_v42.py')]+(args.arguments or ['status']))
    elif args.action=='orchestrate':
        cmd([sys.executable,str(ROOT/'ops/orchestrate.py')]+(args.arguments or ['status']))
    elif args.action=='service-status':cmd(['systemctl','--no-pager','status',UNIT],check=False)
    elif args.action=='logs':show_logs(args)
    elif args.action=='decision':
        root_required()
        sys.path.insert(0,str(ROOT/'soar'))
        import soarctl
        sys.argv = ['soarctl.py','status',args.decision_id]
        soarctl.main()

if __name__=='__main__': main()
