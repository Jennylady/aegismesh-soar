<group name="aegismesh_soar,">
  <rule id="119870" level="5">
    <match>AEGISMESH-SOAR-PROOF decision_id=</match>
    <description>AEGISMESH SOAR - agent action proof received</description>
    <group>aegismesh_soar,active_response,</group>
  </rule>
  <rule id="119871" level="6">
    <match>AEGISMESH-SOAR-BLOCK decision_id=</match>
    <description>AEGISMESH SOAR - Linux agent firewall block applied</description>
    <group>aegismesh_soar,active_response,</group>
  </rule>
  <rule id="119872" level="7">
    <match>AEGISMESH-SOAR-WINBLOCK decision_id=</match>
    <description>AEGISMESH SOAR - Windows Firewall block applied</description>
    <group>aegismesh_soar,active_response,</group>
  </rule>
  <rule id="119873" level="5">
    <match>AEGISMESH-SOAR-WINUNBLOCK decision_id=</match>
    <description>AEGISMESH SOAR - Windows Firewall containment expired and removed</description>
    <group>aegismesh_soar,active_response,</group>
  </rule>
</group>
